{
  "name": "@dsh-tools/dsh-install",
  "version": "0.1.0",
  "description": "Install and manage MCP servers and skills for the DeepSeek Harness: registry-backed install, live remount aggregator, slash commands, ecosystem importers, marketplaces, and auditable install reports.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "mcp",
    "skills",
    "installer",
    "plugin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cli": {
      "types": "./lib/cli.d.mts",
      "default": "./lib/cli.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.mjs",
    "lib/**/*.mjs.map",
    "lib/**/*.d.mts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.5",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT"
}
